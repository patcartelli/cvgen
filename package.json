{
  "name": "cvgen",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "cvgen": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "simple-git-hooks",
    "dev": "tsx src/cli/index.ts",
    "validate-fixtures": "tsx scripts/validate-fixtures.ts",
    "smoke-render": "tsx scripts/smoke-render.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "npx biome check --write . && gitleaks protect -v --staged"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "puppeteer": "^25.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^24",
    "pdf-parse": "^2.4.5",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "puppeteer@25.4.0": true
  }
}
